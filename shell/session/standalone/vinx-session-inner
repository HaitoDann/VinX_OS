#!/bin/sh
# Intérieur de la session VinX autonome (ADR 0053) : tourne dans KWin (WAYLAND_DISPLAY défini).
# Transmet l'environnement à systemd et D-Bus, démarre vinx-session.target, puis attend la fin de
# session : quand la cible s'arrête (fermeture de session), ce script se termine et KWin avec lui.
VARS="XKB_DEFAULT_LAYOUT XKB_DEFAULT_VARIANT XKB_DEFAULT_MODEL XKB_DEFAULT_OPTIONS WAYLAND_DISPLAY DISPLAY XAUTHORITY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_SESSION_ID XDG_SEAT
XDG_CONFIG_DIRS XDG_DATA_DIRS VINX_SESSION VINX_STANDALONE PLASMA_DEFAULT_SHELL XCURSOR_THEME
KDE_FULL_SESSION KDE_SESSION_VERSION KDE_APPLICATIONS_AS_SCOPE"
log() { logger -t vinx-session "$*" 2>/dev/null || true; }

# shellcheck disable=SC2086
systemctl --user import-environment $VARS 2>/dev/null
# shellcheck disable=SC2086
dbus-update-activation-environment --systemd $VARS 2>/dev/null

# Restes d'une session précédente (fermeture brutale, veille interrompue) : on repart de zéro.
systemctl --user stop vinx-session.target vinx-shell.service vinx-shell-fallback.service 2>/dev/null
systemctl --user reset-failed vinx-session.target vinx-shell.service vinx-shell-fallback.service 2>/dev/null

log "session autonome : démarrage de vinx-session.target"
if ! systemctl --user start vinx-session.target; then
	log "vinx-session.target n'a pas pu démarrer"
	exit 1
fi
while systemctl --user is-active -q vinx-session.target; do
	sleep 2
done
log "fin de la session autonome"
systemctl --user stop graphical-session.target 2>/dev/null
# shellcheck disable=SC2086
systemctl --user unset-environment $VARS 2>/dev/null
exit 0
