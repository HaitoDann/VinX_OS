#!/bin/sh
# Session VinX OS (ADR 0009) — lanceur volontairement minimal et stable (ADR 0049).
# Les réglages de la session sont dans /usr/lib/vinx/vinx-session-setup. Si ce fichier est
# illisible, ou si les deux dernières sessions VinX se sont arrêtées aussitôt après leur
# démarrage, on ouvre une **session de secours** : le bureau Plasma standard, avec une bulle
# qui explique comment revenir à la version précédente de VinX. On peut toujours se connecter.
SETUP=${VINX_SESSION_SETUP:-/usr/lib/vinx/vinx-session-setup}
# Remplaçables pour les tests (tests/session-fallback-test.sh).
STARTPLASMA=${VINX_STARTPLASMA:-/usr/bin/startplasma-wayland}
# Session autonome, sans Plasma (ADR 0053) : KWin et vinx-session.target au lieu de startplasma.
# La session de secours reste le bureau Plasma (variable STARTPLASMA ci-dessus).
STANDALONE=""
if [ "${1:-}" = "--standalone" ]; then
	shift
	STANDALONE=${VINX_STANDALONE_START:-/usr/lib/vinx/vinx-session-standalone}
fi
SAFE_NOTICE=${VINX_SAFE_NOTICE:-/usr/lib/vinx/vinx-safe-notice}
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/vinx
FAILS="$STATE/session-failures"
mkdir -p "$STATE" 2>/dev/null
log() { logger -t vinx-session "$*" 2>/dev/null || true; }

fails=$(cat "$FAILS" 2>/dev/null || echo 0)
case $fails in ''|*[!0-9]*) fails=0 ;; esac

safe=""
if ! sh -n "$SETUP" 2>/dev/null; then
	safe="setup"
	log "réglages de session illisibles ($SETUP) : session de secours"
elif [ "$fails" -ge 2 ]; then
	safe="crash"
	log "$fails sessions VinX arrêtées aussitôt : session de secours"
fi

if [ -n "$safe" ]; then
	echo 0 > "$FAILS"
	# Plasma standard (plasmashell démarre, VINX_SESSION n'est pas défini) + explication.
	export VINX_SAFE_MODE="$safe"
	"$SAFE_NOTICE" &
	exec "$STARTPLASMA" "$@"
fi

# shellcheck source=/dev/null
. "$SETUP"
vinx_setup_start

begin=$(date +%s)
"${STANDALONE:-$STARTPLASMA}" "$@"
status=$?
# Arrêt en moins de 30 s avec une erreur : compté comme un échec de démarrage.
if [ "$status" -ne 0 ] && [ $(( $(date +%s) - begin )) -lt 30 ]; then
	echo $((fails + 1)) > "$FAILS"
	log "session arrêtée aussitôt (code $status)"
else
	echo 0 > "$FAILS"
fi

vinx_setup_stop
exit $status
