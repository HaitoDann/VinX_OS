#!/bin/sh
# Outil administrateur de VinX OS, appelé via pkexec (action polkit org.vinx.admin).
# Chaque action valide strictement ses arguments : rien n'est passé tel quel à un shell.
#
#   printer-add FILE URI      ajoute une imprimante réseau sans pilote (IPP Everywhere)
#   printer-remove FILE       supprime une imprimante
#   install PAQUET…           installe des pilotes ; active les dépôts « non-free » si nécessaire
#   charge-limit 80|100       limite de charge de la batterie (si le matériel le permet)
#   shell-rollback VERSION    réinstalle une version gardée de vinx-shell (/var/lib/vinx/versions)
#   journal                   avertissements et erreurs du journal système (assistant de dépannage)
set -eu
[ "$(id -u)" = 0 ] || [ "${VINX_ADMIN_CHECK:-0}" = 1 ] || { echo "À lancer via pkexec." >&2; exit 1; }

# Une seule ligne : grep valide ligne par ligne, « nom-valide\nautre chose » passerait sinon.
NL='
'
one_line() { case "$1" in *"$NL"*) return 1 ;; esac; }
valid_queue() { one_line "$1" && printf '%s' "$1" | grep -Eq '^[A-Za-z0-9_][A-Za-z0-9_-]{0,126}$'; }
valid_uri() { one_line "$1" && printf '%s' "$1" | grep -Eq '^(ipps?|dnssd)://[]A-Za-z0-9._~%/:@[-]+$'; }
valid_pkg() { one_line "$1" && printf '%s' "$1" | grep -Eq '^[a-z0-9][a-z0-9+.-]{1,62}$'; }

# Active la section non-free (pilote NVIDIA…) dans les sources Debian.
enable_nonfree() {
	src=/etc/apt/sources.list.d/debian.sources
	if [ -f "$src" ]; then
		grep -q 'non-free ' "$src" || grep -q 'non-free$' "$src" || \
			sed -i -E '/^Components:/{/(^| )non-free( |$)/!s/$/ non-free/}' "$src"
	elif [ -f /etc/apt/sources.list ]; then
		sed -i -E '/^deb .*debian/{/ non-free( |$)/!s/$/ non-free/}' /etc/apt/sources.list
	fi
}

case "${1:-}" in
printer-add)
	if ! { [ $# -eq 3 ] && valid_queue "$2" && valid_uri "$3"; }; then echo "Arguments invalides." >&2; exit 2; fi
	[ "${VINX_ADMIN_CHECK:-0}" = 1 ] && exit 0
	lpadmin -p "$2" -v "$3" -m everywhere -E
	cupsenable "$2" || true
	cupsaccept "$2" || true
	;;
printer-remove)
	if ! { [ $# -eq 2 ] && valid_queue "$2"; }; then echo "Arguments invalides." >&2; exit 2; fi
	[ "${VINX_ADMIN_CHECK:-0}" = 1 ] && exit 0
	lpadmin -x "$2"
	;;
install)
	shift
	[ $# -ge 1 ] || { echo "Aucun paquet." >&2; exit 2; }
	for p in "$@"; do valid_pkg "$p" || { echo "Nom de paquet invalide : $p" >&2; exit 2; }; done
	[ "${VINX_ADMIN_CHECK:-0}" = 1 ] && exit 0
	case " $* " in *" nvidia-driver "*) enable_nonfree ;; esac
	apt-get update
	# Les en-têtes du noyau sont nécessaires aux pilotes compilés (NVIDIA, DKMS).
	case " $* " in *" nvidia-driver "*) set -- "$@" linux-headers-amd64 ;; esac
	DEBIAN_FRONTEND=noninteractive apt-get install -y "$@"
	;;
charge-limit)
	case "${2:-}" in 80|100) ;; *) echo "Arguments invalides." >&2; exit 2 ;; esac
	[ $# -eq 2 ] || { echo "Arguments invalides." >&2; exit 2; }
	[ "${VINX_ADMIN_CHECK:-0}" = 1 ] && exit 0
	found=0
	for f in /sys/class/power_supply/BAT*/charge_control_end_threshold; do
		[ -w "$f" ] || continue
		echo "$2" > "$f"
		found=1
	done
	[ "$found" = 1 ] || { echo "Limite de charge non prise en charge par cet ordinateur." >&2; exit 3; }
	# Réappliquée au démarrage (certains ordinateurs l'oublient) : vinx-charge-limit.service.
	mkdir -p /etc/vinx && echo "$2" > /etc/vinx/charge-limit
	systemctl enable vinx-charge-limit.service >/dev/null 2>&1 || true
	;;
shell-rollback)
	[ $# -eq 2 ] && one_line "$2" && printf '%s' "$2" | grep -Eq '^[0-9][0-9A-Za-z.+~-]{0,40}$' || { echo "Arguments invalides." >&2; exit 2; }
	deb=""
	for f in /var/lib/vinx/versions/vinx-shell_*.deb; do
		[ -f "$f" ] && [ "$(dpkg-deb -f "$f" Version)" = "$2" ] && deb=$f
	done
	[ -n "$deb" ] || { echo "Version $2 introuvable." >&2; exit 3; }
	[ "${VINX_ADMIN_CHECK:-0}" = 1 ] && exit 0
	DEBIAN_FRONTEND=noninteractive apt-get install -y --allow-downgrades "$deb"
	;;
journal)
	journalctl -b -p 4 -n 4000 -o short --no-pager
	;;
*)
	echo "usage : vinx-admin printer-add FILE URI | printer-remove FILE | install PAQUET… | charge-limit 80|100 | shell-rollback VERSION | journal" >&2
	exit 2
	;;
esac
